@page "/login"
@rendermode InteractiveServer
@using LaPachangaDelMundialV2.Controllers
@using LaPachangaDelMundialV2.Models
@using LaPachangaDelMundialV2.Utils
@inject SesionUsuario Sesion
@inject UsuarioController UsuarioCtrl
@inject NavigationManager Nav

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h3>⚽ La Pachanga del Mundial</h3>
                </div>
                <div class="card-body">
                    <h5 class="card-title text-center mb-4">Iniciar Sesión</h5>

                    @if (!string.IsNullOrEmpty(mensaje))
                    {
                        <div class="alert alert-danger">@mensaje</div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Usuario</label>
                        <input class="form-control" @bind="nombreUsuario" placeholder="Nombre de usuario" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input class="form-control" @bind="contrasena" type="password" placeholder="Contraseña" />
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-success" @onclick="Ingresar">Ingresar</button>
                        <button class="btn btn-outline-secondary" @onclick="IrARegistro">Registrarse</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    string nombreUsuario = "";
    string contrasena = "";
    string mensaje = "";

    void Ingresar()
    {
        mensaje = "";

        if (string.IsNullOrEmpty(nombreUsuario) || string.IsNullOrEmpty(contrasena))
        {
            mensaje = "Por favor completa todos los campos.";
            return;
        }

        Usuario usuarioDesactivado = UsuarioCtrl.ObtenerDesactivado(nombreUsuario);
        if (usuarioDesactivado != null)
        {
            mensaje = "Tu cuenta está desactivada, ponerse en contacto con el administrador.";
            return;
        }

        Usuario usuario = UsuarioCtrl.Login(nombreUsuario, contrasena);

        if (usuario == null)
        {
            mensaje = "Usuario o contraseña incorrectos.";
            return;
        }

        Sesion.IniciarSesion(usuario);

        if (usuario.EsAdministrador)
            Nav.NavigateTo("/admindashboard");
        else
            Nav.NavigateTo("/dashboard");
    }

    void IrARegistro()
    {
        Nav.NavigateTo("/registro");
    }
}