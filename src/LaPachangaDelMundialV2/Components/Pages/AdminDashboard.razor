@page "/admindashboard"
@rendermode InteractiveServer
@using LaPachangaDelMundialV2.Utils
@inject SesionUsuario Sesion
@inject NavigationManager Nav

@if (!Sesion.EstaLogueado || !Sesion.EsAdministrador)
{
    <div class="container mt-5">
        <div class="card shadow mx-auto" style="max-width: 600px;">

            <div class="card-header bg-dark text-white text-center">
                <h4 class="mb-0">⚽ La Pachanga del Mundial</h4>
            </div>

            <div class="card-body text-center">
                <p class="mb-0">Redirigiendo...</p>
            </div>

        </div>
    </div>
}
else
{
    <div class="container mt-5">

        <div class="card shadow mx-auto" style="max-width: 800px;">

            <div class="card-header bg-dark text-white text-center">
                <h3 class="mb-1">⚽ La Pachanga del Mundial</h3>
                <p class="mb-0">
                    Panel de Administración —
                    <strong>@Sesion.UsuarioActivo.NombreUsuario</strong>
                </p>
            </div>

            <div class="card-body">

                <h5 class="text-center mb-4">🛠️ Gestión</h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <button class="btn btn-outline-primary w-100 py-3"
                                @onclick="IrAPartidos">
                            <span class="fs-3 d-block">⚽</span>
                            Gestionar Partidos
                        </button>
                    </div>

                    <div class="col-md-6">
                        <button class="btn btn-outline-primary w-100 py-3"
                                @onclick="IrAUsuarios">
                            <span class="fs-3 d-block">👥</span>
                            Gestionar Usuarios
                        </button>
                    </div>

                    <div class="col-12">
                        <button class="btn btn-outline-primary w-100 py-3"
                                @onclick="IrAEstadisticas">
                            <span class="fs-3 d-block">📊</span>
                            Estadísticas
                        </button>
                    </div>

                </div>

                <hr class="my-4" />

                <button class="btn btn-outline-danger w-100"
                        @onclick="CerrarSesion">
                    🚪 Cerrar Sesión
                </button>

            </div>

        </div>

    </div>
}

@code {
    protected override void OnInitialized()
    {
        if (!Sesion.EstaLogueado || !Sesion.EsAdministrador)
            Nav.NavigateTo("/login");
    }

    void IrAPartidos() => Nav.NavigateTo("/adminpartidos");
    void IrAUsuarios() => Nav.NavigateTo("/adminusuarios");
    void IrAEstadisticas() => Nav.NavigateTo("/estadisticas");

    void CerrarSesion()
    {
        Sesion.CerrarSesion();
        Nav.NavigateTo("/login");
    }
}