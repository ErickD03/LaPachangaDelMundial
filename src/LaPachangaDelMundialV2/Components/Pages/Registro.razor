@page "/registro"
@rendermode InteractiveServer
@using LaPachangaDelMundialV2.Controllers
@using LaPachangaDelMundialV2.Models
@using LaPachangaDelMundialV2.Utils
@inject UsuarioController UsuarioCtrl
@inject NavigationManager Nav

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center">
                    <h3>⚽ La Pachanga del Mundial</h3>
                </div>
                <div class="card-body">
                    <h5 class="card-title text-center mb-4">Registro de Usuario</h5>

                    @if (!string.IsNullOrEmpty(mensaje))
                    {
                        <div class="alert alert-@(colorMensaje == "green" ? "success" : "danger")">
                            @mensaje
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Nombre de usuario</label>
                        <input class="form-control" @bind="nombreUsuario" placeholder="Mínimo 4 caracteres" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input class="form-control" @bind="contrasena" type="password" placeholder="Mínimo 6 caracteres" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">País preferido</label>
                        <select class="form-select" @bind="codigoPais">
                            <option value="">-- Seleccioná un país --</option>
                            @foreach (var seleccion in selecciones)
                            {
                                <option value="@seleccion.Codigo">@seleccion.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-success" @onclick="Registrar">Registrarse</button>
                        <button class="btn btn-outline-secondary" @onclick="IrALogin">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    string nombreUsuario = "";
    string contrasena = "";
    string codigoPais = "";
    string mensaje = "";
    string colorMensaje = "red";

    List<Seleccion> selecciones = new List<Seleccion>();

    protected override void OnInitialized()
    {
        selecciones = JsonLoader.CargarSelecciones();
    }

    void Registrar()
    {
        mensaje = "";

        if (string.IsNullOrEmpty(nombreUsuario) || string.IsNullOrEmpty(contrasena))
        {
            mensaje = "Por favor completá todos los campos.";
            return;
        }

        if (nombreUsuario.Length < 4)
        {
            mensaje = "El nombre de usuario debe tener al menos 4 caracteres.";
            return;
        }

        if (contrasena.Length < 6)
        {
            mensaje = "La contraseña debe tener al menos 6 caracteres.";
            return;
        }

        if (string.IsNullOrEmpty(codigoPais))
        {
            mensaje = "Por favor seleccioná un país.";
            return;
        }

        bool registrado = UsuarioCtrl.Registrar(nombreUsuario, contrasena, codigoPais);

        if (!registrado)
        {
            mensaje = "Ese nombre de usuario ya está en uso. Elegí otro.";
            return;
        }

        colorMensaje = "green";
        mensaje = "¡Registro exitoso! Ya podés iniciar sesión.";
    }

    void IrALogin() => Nav.NavigateTo("/login");
}