@page "/partidos"
@rendermode InteractiveServer
@using LaPachangaDelMundialV2.Controllers
@using LaPachangaDelMundialV2.Models
@using LaPachangaDelMundialV2.Utils
@inject SesionUsuario Sesion
@inject PartidoController PartidoCtrl
@inject NavigationManager Nav

@if (!Sesion.EstaLogueado)
{
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">

                <div class="card shadow">

                    <div class="card-header bg-dark text-white text-center">
                        <h4>⚽ La Pachanga del Mundial</h4>
                    </div>

                    <div class="card-body text-center">
                        <p>Redirigiendo...</p>
                    </div>

                </div>

            </div>
        </div>
    </div>
}
else
{
    <div class="container mt-5">

        <div class="row justify-content-center">
            <div class="col-md-10">

                <div class="card shadow">

                    <div class="card-header bg-dark text-white text-center">

                        <h3>⚽ Partidos del Mundial 2026</h3>

                    </div>

                    <div class="card-body">

                        <div class="mb-4">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    @onclick="VolverDashboard">
                                ← Volver
                            </button>

                        </div>

                        <ul class="nav nav-tabs mb-4">

                            <li class="nav-item">
                                <button type="button"
                                        class="nav-link @(pestanaActiva == "ultimos" ? "active" : "")"
                                        @onclick='() => pestanaActiva = "ultimos"'>
                                    Últimos 5
                                </button>
                            </li>

                            <li class="nav-item">
                                <button type="button"
                                        class="nav-link @(pestanaActiva == "proximos" ? "active" : "")"
                                        @onclick='() => pestanaActiva = "proximos"'>
                                    Próximos 24h
                                </button>
                            </li>

                            <li class="nav-item">
                                <button type="button"
                                        class="nav-link @(pestanaActiva == "grupos" ? "active" : "")"
                                        @onclick='() => pestanaActiva = "grupos"'>
                                    Tabla de Grupos
                                </button>
                            </li>

                            <li class="nav-item">
                                <button type="button"
                                        class="nav-link @(pestanaActiva == "eliminatoria" ? "active" : "")"
                                        @onclick='() => pestanaActiva = "eliminatoria"'>
                                    Fase Eliminatoria
                                </button>
                            </li>

                        </ul>

                        <div class="d-grid d-md-flex justify-content-md-end mb-4">

                            <button type="button"
                                    class="btn btn-outline-primary"
                                    @onclick="CargarDatos">
                                🔄 Recargar con fecha actual
                            </button>

                        </div>

                        @if (pestanaActiva == "ultimos")
                        {
                            <h5 class="mb-3">
                                ⚽ Últimos 5 partidos
                            </h5>

                            @if (ultimos.Count == 0)
                            {
                                <div class="alert alert-secondary">
                                    No hay partidos registrados.
                                </div>
                            }
                            else
                            {
                                <div class="list-group">

                                    @foreach (var partido in ultimos)
                                    {
                                        <div class="list-group-item">

                                            <div class="row align-items-center">

                                                <div class="col-md-3 text-muted">
                                                    @partido.FechaHora.ToString("dd/MM")
                                                </div>

                                                <div class="col-md-9">

                                                    <strong>
                                                        @PartidoCtrl.ObtenerNombreSeleccion(
                                                        partido.CodigoLocal)
                                    </strong>

                                    <span class="mx-2">
                                        @partido.GolesLocal
                                        -
                                        @partido.GolesVisitante
                                    </span>

                                    <strong>
                                        @PartidoCtrl.ObtenerNombreSeleccion(
                                                                                partido.CodigoVisitante)
                                    </strong>

                                </div>

                            </div>

                        </div>
                                                }

                                </div>
                            }
                        }

                        @if (pestanaActiva == "proximos")
                        {
                            <h5 class="mb-3">
                                ⏰ Próximos partidos (24 horas)
                            </h5>

                            @if (proximos.Count == 0)
                            {
                                <div class="alert alert-secondary">
                                    No hay partidos en las próximas 24 horas.
                                </div>
                            }
                            else
                            {
                                <div class="list-group">

                                    @foreach (var partido in proximos)
                                    {
                                        <div class="list-group-item">

                                            <div class="d-flex justify-content-between align-items-center flex-wrap">

                                                <div>
                                                    <strong>
                                                        @PartidoCtrl.ObtenerNombreSeleccion(
                                                        partido.CodigoLocal)
                                    </strong>

                                    <span class="mx-2 text-muted">
                                        vs
                                    </span>

                                    <strong>
                                        @PartidoCtrl.ObtenerNombreSeleccion(
                                                                                partido.CodigoVisitante)
                                    </strong>
                                </div>

                                <div class="mt-2 mt-md-0">

                                    <span class="badge bg-primary me-2">
                                        @partido.FechaHora.ToString("dd/MM HH:mm")
                                    </span>

                                    <span class="badge bg-secondary">
                                        @partido.Fase
                                    </span>

                                </div>

                            </div>

                        </div>
                                                }

                                </div>
                            }
                        }

                        @if (pestanaActiva == "grupos")
                        {
                            <h5 class="mb-3">
                                🏆 Tabla de Grupos
                            </h5>

                            <div class="mb-4">

                                <label class="form-label">
                                    Seleccionar grupo
                                </label>

                                <select class="form-select"
                                        @bind="grupoSeleccionado"
                                        @bind:after="CargarTabla">

                                    @foreach (var grupo in grupos)
                                    {
                                        <option value="@grupo">
                                            Grupo @grupo
                                        </option>
                                    }

                                </select>

                            </div>

                            @if (tablaGrupo.Count > 0)
                            {
                                <div class="table-responsive">

                                    <table class="table table-striped table-hover align-middle">

                                        <thead class="table-dark">
                                            <tr>
                                                <th>#</th>
                                                <th>Equipo</th>
                                                <th>PJ</th>
                                                <th>G</th>
                                                <th>E</th>
                                                <th>P</th>
                                                <th>GF</th>
                                                <th>GC</th>
                                                <th>DG</th>
                                                <th>Pts</th>
                                            </tr>
                                        </thead>

                                        <tbody>

                                            @for (int i = 0; i < tablaGrupo.Count; i++)
                                            {
                                                var pos = tablaGrupo[i];

                                                <tr>

                                                    <td>
                                                        <strong>
                                                            @(i + 1)
                                                        </strong>
                                                    </td>

                                                    <td>
                                                        @pos.Nombre
                                                    </td>

                                                    <td>
                                                        @pos.PartidosJugados
                                                    </td>

                                                    <td>
                                                        @pos.Ganados
                                                    </td>

                                                    <td>
                                                        @pos.Empatados
                                                    </td>

                                                    <td>
                                                        @pos.Perdidos
                                                    </td>

                                                    <td>
                                                        @pos.GolesFavor
                                                    </td>

                                                    <td>
                                                        @pos.GolesContra
                                                    </td>

                                                    <td>
                                                        @pos.DiferenciaGoles
                                                    </td>

                                                    <td>
                                                        <span class="badge bg-success">
                                                            @pos.Puntos
                                                        </span>
                                                    </td>

                                                </tr>
                                            }

                                        </tbody>

                                    </table>

                                </div>
                            }
                            else
                            {
                                <div class="alert alert-secondary">
                                    No hay información disponible para este grupo.
                                </div>
                            }
                        }

                        @if (pestanaActiva == "eliminatoria")
                        {
                            <h5 class="mb-3">
                                🏆 Fase Eliminatoria
                            </h5>

                            @foreach (var fase in fases)
                            {
                                var partidos = PartidoCtrl.ObtenerPorFase(fase);

                                @if (partidos.Count > 0)
                                {
                                    <div class="card shadow-sm mb-4">

                                        <div class="card-header bg-dark text-white">
                                            <strong>
                                                @fase
                                            </strong>
                                        </div>

                                        <div class="card-body p-0">

                                            <div class="list-group list-group-flush">

                                                @foreach (var partido in partidos)
                                                {
                                                    string local =
                                                    PartidoCtrl.ObtenerNombreSeleccion(
                                                    partido.CodigoLocal);

                                                    string visitante =
                                                    PartidoCtrl.ObtenerNombreSeleccion(
                                                    partido.CodigoVisitante);

                                                    <div class="list-group-item">

                                                        <div class="d-flex justify-content-between align-items-center flex-wrap">

                                                            @if (partido.Estado == EstadoPartido.Finalizado)
                                                            {
                                                                <div>

                                                                    <strong>
                                                                        @local
                                                                    </strong>

                                                                    <span class="mx-2">
                                                                        @partido.GolesLocal
                                                                        -
                                                                        @partido.GolesVisitante
                                                                    </span>

                                                                    <strong>
                                                                        @visitante
                                                                    </strong>

                                                                </div>

                                                                <span class="badge bg-success">
                                                                    Finalizado
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <div>

                                                                    <strong>
                                                                        @local
                                                                    </strong>

                                                                    <span class="mx-2 text-muted">
                                                                        vs
                                                                    </span>

                                                                    <strong>
                                                                        @visitante
                                                                    </strong>

                                                                </div>

                                                                <span class="badge bg-secondary">
                                                                    @partido.Estado
                                                                </span>
                                                            }

                                                        </div>

                                                    </div>
                                                }

                                            </div>

                                        </div>

                                    </div>
                                }
                            }
                        }

                    </div>
                </div>

            </div>
        </div>

    </div>
}

@code {

    void VolverDashboard()
    {
        Nav.NavigateTo("/dashboard");
    }

    string pestanaActiva = "ultimos";
    string grupoSeleccionado = "A";

    List<Partido> ultimos = new List<Partido>();
    List<Partido> proximos = new List<Partido>();
    List<PosicionGrupo> tablaGrupo = new List<PosicionGrupo>();

    string[] grupos = { "A","B","C","D","E","F","G","H","I","J","K","L" };
    string[] fases = { "Dieciseisavos","Octavos","Cuartos","Semifinales","TercerPuesto","Final" };

    protected override void OnInitialized()
    {
        if (!Sesion.EstaLogueado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        CargarDatos();
    }

    void CargarDatos()
    {
        PartidoCtrl.ActualizarEstados();
        ultimos = PartidoCtrl.ObtenerUltimos5();
        proximos = PartidoCtrl.ObtenerProximos24Horas();
        CargarTabla();
    }

    void CargarTabla()
    {
        tablaGrupo = PartidoCtrl.CalcularTablaGrupo(grupoSeleccionado);
    }
}