@page "/adminusuarios"
@rendermode InteractiveServer
@using LaPachangaDelMundialV2.Controllers
@using LaPachangaDelMundialV2.Models
@using LaPachangaDelMundialV2.Utils
@inject SesionUsuario Sesion
@inject UsuarioController UsuarioCtrl
@inject NavigationManager Nav

@if (!Sesion.EstaLogueado || !Sesion.EsAdministrador)
{
    <div class="container mt-5">
        <div class="card shadow mx-auto" style="max-width: 600px;">

            <div class="card-header bg-dark text-white text-center">
                <h4 class="mb-0">⚽ La Pachanga del Mundial</h4>
            </div>

            <div class="card-body text-center">
                <p class="mb-0">Redirigiendo...</p>
            </div>

        </div>
    </div>
}
else
{
    <div class="container mt-5">

        <div class="card shadow">

            <div class="card-header bg-dark text-white text-center">
                <h3 class="mb-0">⚽ Gestión de Usuarios</h3>
            </div>

            <div class="card-body">

                <button type="button"
                        class="btn btn-outline-secondary mb-3"
                        @onclick="VolverAdmin">
                    ← Volver
                </button>

                @if (!string.IsNullOrEmpty(mensaje))
                {
                    <div class="alert alert-success">
                        @mensaje
                    </div>
                }

                <h5 class="mb-3">Usuarios registrados</h5>

                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Usuario</th>
                                <th>País</th>
                                <th>Puntos</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var usuario in usuarios)
                            {
                                @if (!usuario.EsAdministrador)
                                {
                                    <tr>

                                        <td>
                                            <strong>@usuario.NombreUsuario</strong>
                                        </td>

                                        <td>
                                            @usuario.CodigoPaisPreferido
                                        </td>

                                        <td>
                                            <span class="badge bg-success">
                                                @usuario.Puntos
                                            </span>
                                        </td>

                                        <td>
                                            @if (usuario.Activo)
                                            {
                                                <span class="badge bg-success">
                                                    Activo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    Desactivado
                                                </span>
                                            }
                                        </td>

                                        <td class="text-center">

                                            @if (usuarioEditandoId == usuario.Id)
                                            {
                                                <div class="d-flex gap-2 justify-content-center flex-wrap">

                                                    <input class="form-control"
                                                           style="max-width: 250px;"
                                                           @bind="nuevaContrasena"
                                                           placeholder="Nueva contraseña"
                                                           type="password" />

                                                    <button type="button"
                                                            class="btn btn-success"
                                                            @onclick="() => ConfirmarReset(usuario)">
                                                        ✓ Confirmar
                                                    </button>

                                                    <button type="button"
                                                            class="btn btn-outline-secondary"
                                                            @onclick="CancelarReset">
                                                        Cancelar
                                                    </button>

                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex gap-2 justify-content-center flex-wrap">

                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-warning"
                                                            @onclick="() => IniciarReset(usuario)">
                                                        🔑 Reset contraseña
                                                    </button>

                                                    @if (usuario.Activo)
                                                    {
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger"
                                                                @onclick="() => DesactivarUsuario(usuario)">
                                                            🚫 Desactivar
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-success"
                                                                @onclick="() => ActivarUsuario(usuario)">
                                                            ✓ Activar
                                                        </button>
                                                    }

                                                </div>
                                            }

                                        </td>

                                    </tr>
                                }
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>

    </div>
}

@code {
    List<Usuario> usuarios = new List<Usuario>();
    string mensaje = "";
    string colorMensaje = "green";
    string usuarioEditandoId = "";
    string nuevaContrasena = "";

    protected override void OnInitialized()
    {
        if (!Sesion.EstaLogueado || !Sesion.EsAdministrador)
        {
            Nav.NavigateTo("/login");
            return;
        }

        usuarios = UsuarioCtrl.ObtenerTodos();
    }

    void ResetearContrasena(Usuario usuario)
    {
        UsuarioCtrl.ResetearContrasena(usuario.Id, "pass123");
        colorMensaje = "green";
        mensaje = $"Contraseña de '{usuario.NombreUsuario}' reseteada a 'pass123'.";
    }

    void DesactivarUsuario(Usuario usuario)
    {
        UsuarioCtrl.DesactivarUsuario(usuario.Id);
        colorMensaje = "orange";
        mensaje = $"Usuario '{usuario.NombreUsuario}' desactivado.";
        usuarios = UsuarioCtrl.ObtenerTodos();
    }

    void ActivarUsuario(Usuario usuario)
    {
        UsuarioCtrl.ActivarUsuario(usuario.Id);
        colorMensaje = "green";
        mensaje = $"Usuario '{usuario.NombreUsuario}' activado.";
        usuarios = UsuarioCtrl.ObtenerTodos();
    }

    void VolverAdmin()
    {
        Nav.NavigateTo("/admindashboard");
    }

    void IniciarReset(Usuario usuario)
    {
        usuarioEditandoId = usuario.Id;
        nuevaContrasena = "";
    }

    void ConfirmarReset(Usuario usuario)
    {
        if (string.IsNullOrEmpty(nuevaContrasena))
        {
            colorMensaje = "red";
            mensaje = "La contraseña no puede estar vacía.";
            return;
        }

        if (nuevaContrasena.Length < 6)
        {
            colorMensaje = "red";
            mensaje = "La contraseña debe tener al menos 6 caracteres.";
            return;
        }

        UsuarioCtrl.ResetearContrasena(usuario.Id, nuevaContrasena);
        colorMensaje = "green";
        mensaje = $"Contraseña de '{usuario.NombreUsuario}' actualizada correctamente.";
        usuarioEditandoId = "";
        nuevaContrasena = "";
    }

    void CancelarReset()
    {
        usuarioEditandoId = "";
        nuevaContrasena = "";
    }
}