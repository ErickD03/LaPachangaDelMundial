@page "/quinielas"
@rendermode InteractiveServer
@using LaPachangaDelMundialV2.Controllers
@using LaPachangaDelMundialV2.Models
@using LaPachangaDelMundialV2.Utils
@inject SesionUsuario Sesion
@inject QuinielaController QuinielaCtrl
@inject NavigationManager Nav

@if (!Sesion.EstaLogueado)
{
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">

                <div class="card shadow">

                    <div class="card-header bg-dark text-white text-center">
                        <h4>⚽ La Pachanga del Mundial</h4>
                    </div>

                    <div class="card-body text-center">
                        <p>Redirigiendo...</p>
                    </div>

                </div>

            </div>
        </div>
    </div>
}
else
{
    <div class="container mt-5">

        <div class="row justify-content-center">
            <div class="col-md-10">

                <div class="card shadow">

                    <div class="card-header bg-dark text-white text-center">
                        <h3>🏆 Mis Quinielas</h3>
                    </div>

                    <div class="card-body">

                        <div class="mb-4">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    @onclick="VolverDashboard">
                                ← Volver
                            </button>

                        </div>

                        <ul class="nav nav-tabs mb-4">

                            <li class="nav-item">
                                <button type="button"
                                        class="nav-link @(pestanaActiva == "misquinielas" ? "active" : "")"
                                        @onclick='() => pestanaActiva = "misquinielas"'>
                                    🏆 Mis Quinielas
                                </button>
                            </li>

                            <li class="nav-item">
                                <button type="button"
                                        class="nav-link @(pestanaActiva == "crear" ? "active" : "")"
                                        @onclick='() => pestanaActiva = "crear"'>
                                    ➕ Crear Quiniela
                                </button>
                            </li>

                            <li class="nav-item">
                                <button type="button"
                                        class="nav-link @(pestanaActiva == "unirse" ? "active" : "")"
                                        @onclick='() => pestanaActiva = "unirse"'>
                                    🤝 Unirse a Quiniela
                                </button>
                            </li>

                        </ul>

                        @if (pestanaActiva == "misquinielas")
                        {
                            <h5 class="mb-3">
                                🏆 Mis Quinielas
                            </h5>

                            @if (misQuinielas.Count == 0)
                            {
                                <div class="alert alert-secondary">
                                    No pertenecés a ninguna quiniela todavía.
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">

                                    @foreach (var quiniela in misQuinielas)
                                    {
                                        <div class="col-md-6">

                                            <div class="card shadow-sm h-100">

                                                <div class="card-header bg-light">

                                                    <div class="d-flex justify-content-between align-items-center">

                                                        <strong>
                                                            @quiniela.Nombre
                                                        </strong>

                                                        @if (quiniela.Tipo == TipoQuiniela.Publica)
                                                        {
                                                            <span class="badge bg-success">
                                                                Pública
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">
                                                                Privada
                                                            </span>
                                                        }

                                                    </div>

                                                </div>

                                                <div class="card-body">

                                                    <p class="mb-3">
                                                        👥
                                                        <strong>
                                                            @quiniela.IdsIntegrantes.Count
                                                        </strong>
                                                        integrantes
                                                    </p>

                                                    <div class="d-grid">

                                                        <button type="button"
                                                                class="btn btn-outline-primary"
                                                                @onclick="() => VerTimeline(quiniela)">
                                                            📋 Ver Timeline
                                                        </button>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>
                                    }

                                </div>
                            }

                            @if (quinielaSeleccionada != null)
                            {
                                <hr class="my-4" />

                                <div class="card shadow-sm">

                                    <div class="card-header bg-dark text-white">
                                        <h5 class="mb-0">
                                            🔔 Timeline de @quinielaSeleccionada.Nombre
                                        </h5>
                                    </div>

                                    <div class="card-body">

                                        @if (quinielaSeleccionada.Notificaciones.Count == 0)
                                        {
                                            <div class="alert alert-secondary mb-0">
                                                Sin notificaciones aún.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="list-group">

                                                @foreach (var notif in quinielaSeleccionada.Notificaciones)
                                                {
                                                    <div class="list-group-item">
                                                        🔔 @notif
                                                    </div>
                                                }

                                            </div>
                                        }

                                    </div>

                                </div>
                            }
                        }

                        @if (pestanaActiva == "crear")
                        {
                            <h5 class="mb-3">
                                ➕ Crear nueva quiniela
                            </h5>

                            @if (!string.IsNullOrEmpty(mensajeCrear))
                            {
                                <div class="alert @(colorMensaje == "green" ? "alert-success" : "alert-danger")">
                                    @mensajeCrear
                                </div>
                            }

                            <div class="mb-3">

                                <label class="form-label">
                                    Nombre
                                </label>

                                <input class="form-control"
                                       @bind="nombreNuevaQuiniela"
                                       placeholder="Nombre de la quiniela" />

                            </div>


                            <div class="mb-4">

                                <label class="form-label">
                                    Tipo
                                </label>

                                <select class="form-select"
                                        @bind="tipoNuevaQuiniela">

                                    <option value="Privada">
                                        Privada
                                    </option>

                                    <option value="Publica">
                                        Pública
                                    </option>

                                </select>

                            </div>


                            <div class="d-grid">

                                <button type="button"
                                        class="btn btn-success"
                                        @onclick="CrearQuiniela">
                                    🏆 Crear Quiniela
                                </button>

                            </div>
                        }

                        @if (pestanaActiva == "unirse")
                        {
                            <h5 class="mb-3">
                                🤝 Unirse a una quiniela
                            </h5>

                            @if (!string.IsNullOrEmpty(mensajeUnirse))
                            {
                                <div class="alert @(colorMensajeUnirse == "green" ? "alert-success" : "alert-danger")">
                                    @mensajeUnirse
                                </div>
                            }

                            <p class="text-muted">
                                Quinielas disponibles:
                            </p>


                            @if (quinielasDisponibles.Count == 0)
                            {
                                <div class="alert alert-secondary">
                                    No hay quinielas disponibles para unirse.
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">

                                    @foreach (var quiniela in quinielasDisponibles)
                                    {
                                        <div class="col-md-6">

                                            <div class="card shadow-sm h-100">

                                                <div class="card-header bg-light">

                                                    <div class="d-flex justify-content-between align-items-center">

                                                        <strong>
                                                            @quiniela.Nombre
                                                        </strong>

                                                        @if (quiniela.Tipo == TipoQuiniela.Publica)
                                                        {
                                                            <span class="badge bg-success">
                                                                Pública
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">
                                                                Privada
                                                            </span>
                                                        }

                                                    </div>

                                                </div>

                                                <div class="card-body">

                                                    <p class="mb-3">
                                                        👥
                                                        <strong>
                                                            @quiniela.IdsIntegrantes.Count
                                                        </strong>
                                                        integrantes
                                                    </p>

                                                    <div class="d-grid">

                                                        <button type="button"
                                                                class="btn btn-success"
                                                                @onclick="() => UnirseAQuiniela(quiniela)">
                                                            🤝 Unirse
                                                        </button>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>
                                    }

                                </div>
                            }

                        }

                    </div>
                </div>

            </div>
        </div>

    </div>
}

@code {
    string pestanaActiva = "misquinielas";
    string nombreNuevaQuiniela = "";
    string tipoNuevaQuiniela = "Privada";
    string mensajeCrear = "";
    string mensajeUnirse = "";
    string colorMensaje = "green";
    string colorMensajeUnirse = "green";

    List<Quiniela> misQuinielas = new List<Quiniela>();
    List<Quiniela> quinielasDisponibles = new List<Quiniela>();
    Quiniela quinielaSeleccionada = null;

    protected override void OnInitialized()
    {
        if (!Sesion.EstaLogueado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        CargarDatos();
    }

    void CargarDatos()
    {
        misQuinielas = QuinielaCtrl.ObtenerPorUsuario(Sesion.UsuarioActivo.Id);

        List<Quiniela> todas = QuinielaCtrl.ObtenerTodas();
        quinielasDisponibles = new List<Quiniela>();

        foreach (Quiniela quiniela in todas)
        {
            if (!quiniela.IdsIntegrantes.Contains(Sesion.UsuarioActivo.Id))
                quinielasDisponibles.Add(quiniela);
        }
    }

    void VerTimeline(Quiniela quiniela)
    {
        quinielaSeleccionada = quiniela;
    }

    void CrearQuiniela()
    {
        mensajeCrear = "";

        if (string.IsNullOrEmpty(nombreNuevaQuiniela))
        {
            colorMensaje = "red";
            mensajeCrear = "Por favor ingresá un nombre para la quiniela.";
            return;
        }

        TipoQuiniela tipo = tipoNuevaQuiniela == "Privada"
            ? TipoQuiniela.Privada
            : TipoQuiniela.Publica;

        bool creada = QuinielaCtrl.Crear(
            nombreNuevaQuiniela, tipo, Sesion.UsuarioActivo.Id);

        if (creada)
        {
            colorMensaje = "green";
            mensajeCrear = $"Quiniela '{nombreNuevaQuiniela}' creada exitosamente.";
            nombreNuevaQuiniela = "";
            CargarDatos();
        }
        else
        {
            colorMensaje = "red";
            mensajeCrear = "Ya existe una quiniela con ese nombre.";
        }
    }

    void UnirseAQuiniela(Quiniela quiniela)
    {
        bool unido = QuinielaCtrl.UnirseAQuiniela(quiniela.Id, Sesion.UsuarioActivo.Id);

        if (unido)
        {
            colorMensajeUnirse = "green";
            mensajeUnirse = $"Te uniste a '{quiniela.Nombre}' exitosamente.";
            CargarDatos();
        }
        else
        {
            colorMensajeUnirse = "red";
            mensajeUnirse = "No se pudo unir a la quiniela.";
        }
    }

    void VolverDashboard()
    {
        Nav.NavigateTo("/dashboard");
    }
}